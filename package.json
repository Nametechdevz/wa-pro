{
  "name": "wa-sender",
  "version": "1.0.0",
  "description": "Aplicación de escritorio para envío masivo de mensajes por WhatsApp",
  "main": "dist/main/main.js",
  "homepage": "./",
  "author": "WA-Sender Dev",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run react\" \"wait-on http://localhost:3000 && npm run electron-dev\"",
    "react": "BROWSER=none react-scripts start",
    "react-build": "react-scripts build",
    "electron-dev": "tsc -p tsconfig.main.json && electron .",
    "build": "npm run react-build && tsc -p tsconfig.main.json && electron-builder",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "axios": "^1.6.0",
    "better-sqlite3": "^9.2.2",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5",
    "qrcode": "^1.5.3",
    "dotenv": "^16.3.1",
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.21",
    "typescript": "^5.0.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "electron-is-dev": "^2.0.0",
    "react-scripts": "5.0.1",
    "concurrently": "^8.2.0",
    "wait-on": "^7.0.0",
    "cross-env": "^7.0.3"
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
